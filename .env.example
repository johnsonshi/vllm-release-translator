# Optional GitHub token for higher API rate limits when polling upstream releases
GITHUB_TOKEN=

# Target repositories monitored by the watcher daemon
UPSTREAM_VLLM_REPO=vllm-project/vllm
UPSTREAM_K8S_REPO=kubernetes/kubernetes

# Watcher polling interval in seconds (default: 3600 = 1 hour)
POLL_INTERVAL_SECONDS=3600

# Local review server port
PORT=8765

# Minimum composite eval score required before a draft enters pending_review
MIN_EVAL_GATE_SCORE=0.82
